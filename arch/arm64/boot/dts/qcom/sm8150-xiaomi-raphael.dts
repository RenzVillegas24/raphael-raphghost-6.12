		remoteproc@17300000 {
			compatible = "qcom,sm8150-adsp-pas";
			reg = <0x00 0x17300000 0x00 0x4040>;
			interrupts-extended = <0x01 0x00 0xa2 0x01 0x104 0x00 0x01 0x104 0x01 0x01 0x104 0x02 0x01 0x104 0x03 0x01>;
			interrupt-names = "wdog", "fatal", "ready", "handover", "stop-ack";
			clocks = <0x32 0x00>;
			clock-names = "xo";
			power-domains = <0x91 0x07>;
			memory-region = <0x105>;
			qcom,qmp = <0x8e>;
			qcom,smem-states = <0x106 0x00>;
			qcom,smem-state-names = "stop";
			status = "okay";
			firmware-name = "adsp.mdt";
			phandle = <0x1ed>;

			glink-edge {
				interrupts = <0x00 0x9c 0x01>;
				label = "lpass";
				qcom,remote-pid = <0x02>;
				mboxes = <0x31 0x08>;

				fastrpc {
					compatible = "qcom,fastrpc";
					qcom,glink-channels = "fastrpcglink-apps-dsp";
					label = "adsp";
					qcom,non-secure-domain;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					memory-region = <0x94>;
					qcom,vmids = <0x06 0x05 0x0f 0x03>;

					compute-cb@3 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x03>;
						iommus = <0x34 0x1b23 0x00>;
					};

					compute-cb@4 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x04>;
						iommus = <0x34 0x1b24 0x00>;
					};

					compute-cb@5 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x05>;
						iommus = <0x34 0x1b25 0x00>;
					};
				};
			};
		};

