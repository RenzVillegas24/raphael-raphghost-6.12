					wf_3 {
						qcom,effect-id = <0x03>;
						qcom,wf-vmax-mv = <0xbb8>;
						qcom,wf-pattern = [7e 7e 7e];
						qcom,wf-play-rate-us = <0x1a0b>;
						qcom,lra-auto-resonance-disable;
					};

					wf_4 {
						qcom,effect-id = <0x04>;
						qcom,wf-vmax-mv = <0xbb8>;
						qcom,wf-pattern = [7e 7e];
						qcom,wf-play-rate-us = <0x1388>;
						qcom,lra-auto-resonance-disable;
					};

					wf_5 {
						qcom,effect-id = <0x05>;
						qcom,wf-vmax-mv = <0xbb8>;
						qcom,wf-pattern = [7e 7e 7e];
						qcom,wf-play-rate-us = <0x1a0b>;
						qcom,wf-brake-pattern = <0x3000000>;
						qcom,lra-auto-resonance-disable;
					};
				};
			};

			qcom,pm8150l@4 {
				compatible = "qcom,pm8150l", "qcom,spmi-pmic";
				reg = <0x04 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				pon@800 {
					compatible = "qcom,pm8916-pon";
					reg = <0x800>;
					status = "disabled";
				};

				temp-alarm@2400 {
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400>;
					interrupts = <0x04 0x24 0x00 0x03>;
					io-channels = <0x102 0x06>;
					io-channel-names = "thermal";
					#thermal-sensor-cells = <0x00>;
					phandle = <0x1de>;
				};

				adc@3100 {
					compatible = "qcom,spmi-adc5";
					reg = <0x3100>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#io-channel-cells = <0x01>;
					interrupts = <0x04 0x31 0x00 0x01>;
					phandle = <0x102>;

					channel@0 {
						reg = <0x00>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "ref_gnd";
					};

					channel@1 {
						reg = <0x01>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "vref_1p25";
					};

					channel@6 {
						reg = <0x06>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "die_temp";
					};

					channel@4d {
						reg = <0x4d>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "camera_flash_therm";
					};

					channel@4e {
						reg = <0x4e>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "skin_msm_therm";
					};

					channel@4f {
						reg = <0x4f>;
						qcom,ratiometric;
						qcom,hw-settle-time = <0xc8>;
						qcom,pre-scaling = <0x01 0x01>;
						label = "pa_therm1";
					};
				};

				adc-tm@3500 {
					compatible = "qcom,spmi-adc-tm5";
					reg = <0x3500>;
					interrupts = <0x04 0x35 0x00 0x01>;
					#thermal-sensor-cells = <0x01>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					status = "okay";
					phandle = <0x1e7>;

					cam-therm0@0 {
						reg = <0x00>;
						io-channels = <0x102 0x4d>;
						qcom,ratiometric;
						qcom,hw-settle-time-us = <0xc8>;
					};

					cam-therm1@1 {
						reg = <0x01>;
						io-channels = <0x102 0x4e>;
						qcom,ratiometric;
						qcom,hw-settle-time-us = <0xc8>;
					};

					pa-therm1@2 {
						reg = <0x02>;
						io-channels = <0x102 0x4f>;
						qcom,ratiometric;
						qcom,hw-settle-time-us = <0xc8>;
					};
				};

				gpio@c000 {
					compatible = "qcom,pm8150l-gpio", "qcom,spmi-gpio";
					reg = <0xc000>;
					gpio-controller;
					gpio-ranges = <0x103 0x00 0x00 0x0c>;
					#gpio-cells = <0x02>;
					interrupt-controller;
					#interrupt-cells = <0x02>;
					phandle = <0x103>;

					pwm-out-gpio10-default-state {
						pins = "gpio10";
						function = "func1";
						bias-disable;
						power-source = <0x01>;
						output-low;
						qcom,drive-strength = <0x03>;
						drive-push-pull;
						phandle = <0x1b9>;
					};
				};
			};

			qcom,pm8150l@5 {
				compatible = "qcom,pm8150l", "qcom,spmi-pmic";
				reg = <0x05 0x00>;
