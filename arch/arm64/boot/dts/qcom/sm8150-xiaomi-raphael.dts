			reg = <0x00 0x700>;
			clocks = <0x03 0x02>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x160>;
			next-level-cache = <0x18>;
			qcom,freq-domain = <0x03 0x02>;
			operating-points-v2 = <0x19>;
			interconnects = <0x06 0x00 0x03 0x07 0x01 0x03 0x08 0x00 0x08 0x01>;
			power-domains = <0x1a>;
			power-domain-names = "psci";
			#cooling-cells = <0x02>;
