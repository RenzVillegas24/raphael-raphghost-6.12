		qcom,mss@4080000 {
			compatible = "qcom,sm8150-mpss-pas";
			reg = <0x00 0x4080000 0x00 0x4040>;
			interrupts-extended = <0x01 0x00 0x10a 0x01 0x9d 0x00 0x01 0x9d 0x01 0x01 0x9d 0x02 0x01 0x9d 0x03 0x01 0x9d 0x07 0x01>;
			interrupt-names = "wdog", "fatal", "ready", "handover", "stop-ack", "shutdown-ack";
			clocks = <0x32 0x00>;
			clock-names = "xo";
			power-domains = <0x91 0x07 0x91 0x00>;
			power-domain-names = "cx", "mss";
			memory-region = <0x9e>;
			qcom,qmp = <0x8e>;
			qcom,smem-states = <0x9f 0x00>;
			qcom,smem-state-names = "stop";
			status = "okay";
			firmware-name = "modem.mdt";
			phandle = <0x1f0>;

			glink-edge {
				interrupts = <0x00 0x1c1 0x01>;
				label = "modem";
				qcom,remote-pid = <0x01>;
				mboxes = <0x31 0x0c>;
			};
		};

