				cache-unified;
				next-level-cache = <0x0a>;
				phandle = <0x18>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x1b>;
				};

				core1 {
					cpu = <0x1c>;
				};

				core2 {
					cpu = <0x1d>;
				};

				core3 {
					cpu = <0x1e>;
				};

				core4 {
					cpu = <0x1f>;
				};

				core5 {
					cpu = <0x20>;
				};

				core6 {
					cpu = <0x21>;
				};

				core7 {
					cpu = <0x22>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0-0 {
				compatible = "arm,idle-state";
				idle-state-name = "little-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x163>;
				exit-latency-us = <0x38d>;
				min-residency-us = <0xf5e>;
				local-timer-stop;
				phandle = <0x25>;
			};

			cpu-sleep-1-0 {
				compatible = "arm,idle-state";
				idle-state-name = "big-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0xf1>;
				exit-latency-us = <0x5b5>;
				min-residency-us = <0x1188>;
				local-timer-stop;
				phandle = <0x26>;
			};
		};

		domain-idle-states {

			cluster-sleep-0 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x4100c244>;
				entry-latency-us = <0xcbf>;
				exit-latency-us = <0x19a2>;
				min-residency-us = <0x2703>;
				phandle = <0x27>;
			};
		};
	};

